# =================================================================
# Kitchen - Environment Configuration Example
# Copy this file to .env and adjust variables to fit your environment.
# =================================================================

# ----------------- Timezone -----------------
TZ=Asia/Barnaul

# ----------------- Ports -----------------
BACKEND_PORT=8080
FRONTEND_PORT=80

# ----------------- PostgreSQL Database -----------------
POSTGRES_USER=kitchen
POSTGRES_PASSWORD=kitchen_secret
POSTGRES_DB=kitchen
SPRING_DATASOURCE_URL=jdbc:postgresql://db:5432/kitchen

# ----------------- JWT Security -----------------
# Generate a secure 256-bit or 512-bit string for production
JWT_SECRET=kitchen-jwt-secret-key-that-is-at-least-256-bits-long-kitchen-app-2026
JWT_EXPIRATION_MS=86400000

# ----------------- CORS Origins -----------------
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173,http://localhost:8080

# ----------------- Base URL (used in Telegram links) -----------------
EXTERNAL_URL=http://localhost:8080

# ----------------- Telegram Notifications (Optional) -----------------
# Create bot via @BotFather and get chat ID
TG_BOT_TOKEN=
TB_BOT_CHAT_ID=

# ----------------- Active Directory / LDAP (Optional) -----------------
# Set to 'true' to enable Active Directory authentication
LDAP_ENABLED=false
LDAP_URL=ldap://localhost:389
LDAP_DOMAIN=example.com
LDAP_BASE_DN=DC=example,DC=com
LDAP_USER_DN_PATTERN=
